{
  "additionalProperties": false,
  "description": "Sent by every source about once per second; also carries edge performance metrics.",
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "edge",
        "simulation",
        "replay",
        "manual"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "room_id": {
      "title": "Room Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "fps": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fps"
    },
    "inference_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inference Ms"
    },
    "mem_used_mb": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mem Used Mb"
    }
  },
  "required": [
    "timestamp",
    "source",
    "source_type",
    "room_id"
  ],
  "title": "Heartbeat",
  "type": "object"
}
