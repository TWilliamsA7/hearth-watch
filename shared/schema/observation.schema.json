{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Keypoint": {
      "additionalProperties": false,
      "description": "Coordinates are normalized to the frame: (0, 0) top-left, (1, 1) bottom-right.",
      "properties": {
        "name": {
          "enum": [
            "nose",
            "left_eye",
            "right_eye",
            "left_ear",
            "right_ear",
            "left_shoulder",
            "right_shoulder",
            "left_elbow",
            "right_elbow",
            "left_wrist",
            "right_wrist",
            "left_hip",
            "right_hip",
            "left_knee",
            "right_knee",
            "left_ankle",
            "right_ankle",
            "neck"
          ],
          "title": "Name",
          "type": "string"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Measured keypoint confidence, when available; null is unknown, not zero or certainty.",
          "title": "Confidence"
        }
      },
      "required": [
        "name",
        "x",
        "y",
        "confidence"
      ],
      "title": "Keypoint",
      "type": "object"
    },
    "PostureFeatures": {
      "additionalProperties": false,
      "description": "Per-frame posture features. Every field is optional: missing = not measurable this frame.",
      "properties": {
        "torso_angle_deg": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Neck-to-hip angle from vertical. 0 = upright, 90 = horizontal.",
          "title": "Torso Angle Deg"
        },
        "head_y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized head height (0 = top of frame).",
          "title": "Head Y"
        },
        "hip_y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized mid-hip height (0 = top of frame).",
          "title": "Hip Y"
        },
        "bbox_aspect": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Person bounding box width / height.",
          "title": "Bbox Aspect"
        },
        "vertical_velocity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Change in hip_y per second; positive = moving down.",
          "title": "Vertical Velocity"
        }
      },
      "required": [
        "torso_angle_deg",
        "head_y",
        "hip_y",
        "bbox_aspect",
        "vertical_velocity"
      ],
      "title": "PostureFeatures",
      "type": "object"
    },
    "PosturePrediction": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "title": "Model Revision",
          "type": "string"
        },
        "label": {
          "enum": [
            "standing",
            "sitting",
            "fallen",
            "unknown"
          ],
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detection_count": {
          "minimum": 0,
          "title": "Detection Count",
          "type": "integer"
        },
        "uncertainty_reason": {
          "anyOf": [
            {
              "enum": [
                "no_detection",
                "multiple_people",
                "unsupported_label"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Reason"
        }
      },
      "required": [
        "model_id",
        "model_revision",
        "label",
        "confidence",
        "bbox",
        "detection_count",
        "uncertainty_reason"
      ],
      "title": "PosturePrediction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "obs_id": {
      "title": "Obs Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "source": {
      "description": "Device or generator id, e.g. 'jetson-01' or 'sim'.",
      "title": "Source",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "edge",
        "simulation",
        "replay",
        "manual"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "room_id": {
      "title": "Room Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Unique replay/run id; change on reset.",
      "title": "Run Id"
    },
    "person_detected": {
      "title": "Person Detected",
      "type": "boolean"
    },
    "keypoints": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Keypoint"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Keypoints"
    },
    "features": {
      "anyOf": [
        {
          "$ref": "#/$defs/PostureFeatures"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "posture_prediction": {
      "anyOf": [
        {
          "$ref": "#/$defs/PosturePrediction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "face_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = face detection did not run on this frame.",
      "title": "Face Present"
    },
    "face_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Face Confidence"
    }
  },
  "required": [
    "schema_version",
    "obs_id",
    "timestamp",
    "source",
    "source_type",
    "room_id",
    "scenario_id",
    "run_id",
    "person_detected",
    "keypoints",
    "features",
    "posture_prediction",
    "face_present",
    "face_confidence"
  ],
  "title": "Observation",
  "type": "object"
}
