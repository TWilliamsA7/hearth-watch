{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "edge",
            "simulation",
            "replay"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "acknowledged",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "acknowledged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged At"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "recovered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovered At"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "alert_id",
        "event_id",
        "source",
        "source_type",
        "room_id",
        "scenario_id",
        "run_id",
        "status",
        "severity",
        "opened_at",
        "acknowledged_at",
        "resolved_at",
        "recovered_at",
        "metadata"
      ],
      "title": "Alert",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "edge",
            "simulation",
            "replay"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "event_type": {
          "enum": [
            "possible_fall",
            "recovered",
            "person_visible",
            "person_not_visible",
            "face_present",
            "face_absent",
            "source_offline",
            "source_online",
            "alert_acknowledged",
            "alert_resolved"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "timestamp",
        "source",
        "source_type",
        "room_id",
        "scenario_id",
        "run_id",
        "event_type",
        "confidence",
        "metadata"
      ],
      "title": "Event",
      "type": "object"
    },
    "Keypoint": {
      "additionalProperties": false,
      "description": "Coordinates are normalized to the frame: (0, 0) top-left, (1, 1) bottom-right.",
      "properties": {
        "name": {
          "enum": [
            "nose",
            "left_eye",
            "right_eye",
            "left_ear",
            "right_ear",
            "left_shoulder",
            "right_shoulder",
            "left_elbow",
            "right_elbow",
            "left_wrist",
            "right_wrist",
            "left_hip",
            "right_hip",
            "left_knee",
            "right_knee",
            "left_ankle",
            "right_ankle",
            "neck"
          ],
          "title": "Name",
          "type": "string"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "name",
        "x",
        "y",
        "confidence"
      ],
      "title": "Keypoint",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "obs_id": {
          "title": "Obs Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "source": {
          "description": "Device or generator id, e.g. 'jetson-01' or 'sim'.",
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "edge",
            "simulation",
            "replay"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique replay/run id; change on reset.",
          "title": "Run Id"
        },
        "person_detected": {
          "title": "Person Detected",
          "type": "boolean"
        },
        "keypoints": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Keypoint"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keypoints"
        },
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostureFeatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "face_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = face detection did not run on this frame.",
          "title": "Face Present"
        },
        "face_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Confidence"
        }
      },
      "required": [
        "schema_version",
        "obs_id",
        "timestamp",
        "source",
        "source_type",
        "room_id",
        "scenario_id",
        "run_id",
        "person_detected",
        "keypoints",
        "features",
        "face_present",
        "face_confidence"
      ],
      "title": "Observation",
      "type": "object"
    },
    "PostureFeatures": {
      "additionalProperties": false,
      "description": "Per-frame posture features. Every field is optional: missing = not measurable this frame.",
      "properties": {
        "torso_angle_deg": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Neck-to-hip angle from vertical. 0 = upright, 90 = horizontal.",
          "title": "Torso Angle Deg"
        },
        "head_y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized head height (0 = top of frame).",
          "title": "Head Y"
        },
        "hip_y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized mid-hip height (0 = top of frame).",
          "title": "Hip Y"
        },
        "bbox_aspect": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Person bounding box width / height.",
          "title": "Bbox Aspect"
        },
        "vertical_velocity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Change in hip_y per second; positive = moving down.",
          "title": "Vertical Velocity"
        }
      },
      "required": [
        "torso_angle_deg",
        "head_y",
        "hip_y",
        "bbox_aspect",
        "vertical_velocity"
      ],
      "title": "PostureFeatures",
      "type": "object"
    },
    "SourceStatus": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "edge",
            "simulation",
            "replay"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "online": {
          "title": "Online",
          "type": "boolean"
        },
        "last_seen": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Seen"
        },
        "last_observation_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observation At"
        },
        "observation_stale": {
          "default": true,
          "title": "Observation Stale",
          "type": "boolean"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "inference_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Ms"
        },
        "mem_used_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mem Used Mb"
        }
      },
      "required": [
        "source",
        "source_type",
        "room_id",
        "scenario_id",
        "run_id",
        "online",
        "last_seen",
        "last_observation_at",
        "observation_stale",
        "fps",
        "inference_ms",
        "mem_used_mb"
      ],
      "title": "SourceStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "room_id": {
      "title": "Room Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "alerts": {
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceStatus"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "room_id",
    "observations",
    "events",
    "alerts",
    "sources"
  ],
  "title": "RoomSnapshot",
  "type": "object"
}
