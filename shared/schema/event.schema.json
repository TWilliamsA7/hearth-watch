{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "edge",
        "simulation",
        "replay",
        "manual"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "room_id": {
      "title": "Room Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "person_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Anonymous per-session track id of the person the event concerns (e.g. 'p1'). Not an identity. None = single-person source.",
      "title": "Person Id"
    },
    "event_type": {
      "enum": [
        "possible_fall",
        "recovered",
        "person_visible",
        "person_not_visible",
        "face_present",
        "face_absent",
        "source_offline",
        "source_online",
        "alert_acknowledged",
        "alert_resolved",
        "help_requested"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "source",
    "source_type",
    "room_id",
    "scenario_id",
    "run_id",
    "person_id",
    "event_type",
    "confidence",
    "metadata"
  ],
  "title": "Event",
  "type": "object"
}
