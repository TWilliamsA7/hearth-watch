        },
        "monitor": {
          "title": "Monitor",
          "type": "string"
        },
        "runs": {
          "title": "Runs",
          "type": "integer"
        },
        "simulated_hours": {
          "title": "Simulated Hours",
          "type": "number"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "detected": {
          "$ref": "#/$defs/Rate"
        },
        "delay_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delay Median"
        },
        "delay_p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delay P90"
        },
        "false_alerts_per_hour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "False Alerts Per Hour"
        },
        "falls_by": {
          "items": {
            "$ref": "#/$defs/FallBreakdown"
          },
          "title": "Falls By",
          "type": "array"
        },
        "false_alerts_by": {
          "items": {
            "$ref": "#/$defs/FalseAlertBreakdown"
          },
          "title": "False Alerts By",
          "type": "array"
        },
        "worst": {
          "description": "Runs with missed falls or the most false alerts, worst first.",
          "items": {
            "$ref": "#/$defs/StudyRun"
          },
          "title": "Worst",
          "type": "array"
        }
      },
      "required": [
        "report_version",
        "monitor",
        "runs",
        "simulated_hours",
        "counts",
        "detected",
        "delay_median",
        "delay_p90",
        "false_alerts_per_hour",
        "falls_by",
        "false_alerts_by",
        "worst"
      ],
      "title": "StudyReport",
      "type": "object"
    },
    "StudyRun": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "duration": {
          "title": "Duration",
          "type": "number"
        },
        "tags": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
